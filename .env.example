# Neon connection string (keep ?sslmode=require at the end)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Password for the /admin page. Make it long.
ADMIN_PASSWORD=change-me-to-something-long
PORT=3000
# Which site to run: public, admin, or all (both, for local testing)
APP_MODE=all
# Admin site only: address of the public site, for the 'View public page' button
PUBLIC_URL=
# Email alert for every new pledge (public site), sent like a contact form via FormSubmit.
# The first pledge triggers a one-time activation email to this address: click the link in it.
NOTIFY_EMAIL=charity@irenemusengi.co.zw
# Optional: the random-string alias FormSubmit sends after activation (use instead of the address)
FORMSUBMIT_ALIAS=
# Link to the admin site, included in each email
ADMIN_URL=
# Optional alternative: set a Resend key to send through Resend instead
RESEND_API_KEY=
NOTIFY_FROM=
